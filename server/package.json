{
  "name": "@lorebook/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": { "lorebook": "dist/cli.js" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@node-rs/argon2": "2.2.2",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
