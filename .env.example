# Copy to .env and fill in. Never commit .env.

# Image version to run (matches the release tarball).
LOREBOOK_VERSION=0.1.0

# Public URL people use, e.g. https://lorebook.corp.example
BASE_URL=https://lorebook.corp.example

# Database password (generate one: openssl rand -base64 32)
POSTGRES_PASSWORD=change-me

# Folder on the host holding lorebook.crt and lorebook.key from the internal CA.
TLS_DIR=/etc/lorebook/tls

# Where attachments, backups and exports live. Default is a Docker volume; set a host path
# (e.g. /srv/lorebook/data) to make it easy for the backup tool to reach.
# DATA_DIR=/srv/lorebook/data

# Minutes without editor activity before a check-out expires (spec §6).
CHECKOUT_TIMEOUT_MINUTES=120

# Hours of inactivity before a session ends.
SESSION_IDLE_HOURS=12

# /readyz reports not-ready when free space in /data drops below this.
MIN_FREE_DISK_MB=1024

HTTP_PORT=80
HTTPS_PORT=443
LOG_LEVEL=info
